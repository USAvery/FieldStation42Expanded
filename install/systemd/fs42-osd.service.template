[Unit]
Description=FieldStation42 Shared Display Service (standalone)
After=graphical-session.target fs42.service
Requires=graphical-session.target
PartOf=fs42.service

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment="DISPLAY=:0"
ExecStart=__INSTALL_DIR__/env/bin/python3 -m fs42.tools.display.main
Restart=on-failure
RestartSec=5
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
